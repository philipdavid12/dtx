<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Classroom & Space Booking System</title>
  <style>
    body {
      margin: 0;
      font-family: 'Arial', sans-serif;
      background: linear-gradient(135deg, #8B0000, #000080);
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
    }

    .booking-form {
      background-color: rgba(255, 255, 255, 0.1);
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
      max-width: 400px;
      width: 100%;
      margin-bottom: 30px;
    }

    label, select, input, button {
      display: block;
      width: 100%;
      margin-bottom: 15px;
      font-size: 16px;
    }

    input, select {
      padding: 10px;
      border: none;
      border-radius: 5px;
    }

    button {
      background-color: #ff4500;
      color: #fff;
      border: none;
      padding: 12px;
      border-radius: 5px;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    button:hover {
      background-color: #e03e00;
    }

    .bookings {
      background-color: rgba(255, 255, 255, 0.1);
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
      max-width: 600px;
      width: 100%;
    }

    .booking-item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.3);
      padding: 10px 0;
    }
  </style>
</head>
<body>

  <h1>Classroom & Space Booking System</h1>

  <div class="booking-form">
    <label for="space">Choose a Classroom/Space:</label>
    <select id="space">
      <option value="Room A">Room A</option>
      <option value="Room B">Room B</option>
      <option value="Conference Hall">Conference Hall</option>
      <option value="Computer Lab">Computer Lab</option>
      <option value="Outdoor Space">Outdoor Space</option>
    </select>

    <label for="date">Select Date:</label>
    <input type="date" id="date" required>

    <button onclick="addBooking()">Book Space</button>
  </div>

  <div class="bookings">
    <h2>Current Bookings:</h2>
    <div id="bookingList"></div>
  </div>

  <script>
    let bookings = [];

    function addBooking() {
      const space = document.getElementById('space').value;
      const date = document.getElementById('date').value;

      if (!date) {
        alert('Please select a date.');
        return;
      }

      const booking = {
        space: space,
        date: date
      };

      bookings.push(booking);
      displayBookings();
    }

    function displayBookings() {
      const bookingList = document.getElementById('bookingList');
      bookingList.innerHTML = '';

      bookings.forEach((booking, index) => {
        const div = document.createElement('div');
        div.className = 'booking-item';
        div.innerHTML = `<strong>${booking.space}</strong> on <em>${booking.date}</em>`;
        bookingList.appendChild(div);
      });
    }
  </script>

</body>
</html>
